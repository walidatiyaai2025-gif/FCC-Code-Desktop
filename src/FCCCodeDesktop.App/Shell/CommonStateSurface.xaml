<UserControl x:Class="FCCCodeDesktop.App.Shell.CommonStateSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:FCCCodeDesktop.App.Shell"
             x:Name="Root"
             Background="Transparent"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="{Binding State.Title, ElementName=Root}">
    <UserControl.Resources>
        <Style x:Key="StateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FccBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushBorder}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Info}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushInfoBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Loading}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushInfoBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Success}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushSuccessBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushWarningBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Unavailable}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushWarningBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Offline}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushWarningBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Error}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushErrorBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushError}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Blocked}">
                    <Setter Property="Background" Value="{DynamicResource FccBrushErrorBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FccBrushError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource FccBrushTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Info}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Loading}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Success}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Warning}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Unavailable}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Offline}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Error}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushError}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State.Kind, ElementName=Root}" Value="{x:Static shell:CommonStateKind.Blocked}">
                    <Setter Property="Fill" Value="{DynamicResource FccBrushError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="StateCard"
            MaxWidth="640"
            Padding="{StaticResource FccInset20}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderThickness="1"
            CornerRadius="{StaticResource FccRadiusLarge}"
            Style="{StaticResource StateCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StateIndicator"
                     Grid.Column="0"
                     Width="{StaticResource FccIconSizeSmall}"
                     Height="{StaticResource FccIconSizeSmall}"
                     Margin="0,4,12,0"
                     VerticalAlignment="Top"
                     Style="{StaticResource StateIndicatorStyle}" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StateTitle"
                           Text="{Binding State.Title, ElementName=Root}"
                           Style="{StaticResource FccTextSection}"
                           Foreground="{DynamicResource FccBrushTextPrimary}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StateMessage"
                           Margin="0,4,0,0"
                           Text="{Binding State.Message, ElementName=Root}"
                           Style="{StaticResource FccTextBody}"
                           Foreground="{DynamicResource FccBrushTextSecondary}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StateDetail"
                           Margin="0,8,0,0"
                           Text="{Binding State.Detail, ElementName=Root}"
                           Style="{StaticResource FccTextMetadata}"
                           Foreground="{DynamicResource FccBrushTextMuted}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FccTextMetadata}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.HasDetail, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar x:Name="LoadingProgress"
                             Height="3"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource FccBrushInfo}"
                             Background="{DynamicResource FccBrushSurfaceSubtle}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsBusy, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Button x:Name="StateActionButton"
                        MinWidth="96"
                        Height="{StaticResource FccControlHeightStandard}"
                        Margin="0,12,0,0"
                        Padding="{StaticResource FccInset8}"
                        HorizontalAlignment="Left"
                        Content="{Binding State.ActionLabel, ElementName=Root}"
                        Command="{Binding State.ActionCommand, ElementName=Root}"
                        Foreground="{DynamicResource FccBrushTextPrimary}"
                        Background="{DynamicResource FccBrushSurfaceSubtle}"
                        BorderBrush="{DynamicResource FccBrushBorder}"
                        BorderThickness="1"
                        AutomationProperties.Name="{Binding State.ActionLabel, ElementName=Root}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="FocusVisualStyle">
                                <Setter.Value>
                                    <Style TargetType="Control">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Control">
                                                    <Border BorderBrush="{DynamicResource FccBrushFocus}"
                                                            BorderThickness="{StaticResource FccFocusRingThickness}"
                                                            CornerRadius="{StaticResource FccRadiusSmall}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.HasAction, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource FccBrushHoverOverlay}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource FccBrushPressedOverlay}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
