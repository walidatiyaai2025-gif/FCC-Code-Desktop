<UserControl x:Class="FCCCodeDesktop.App.Shell.NavigationSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:FCCCodeDesktop.App.Shell"
             x:Name="Root"
             Background="{DynamicResource FccBrushSurface}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="Workspace navigation">
    <UserControl.Resources>
        <Style x:Key="FccWorkspaceNavigationButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="{StaticResource FccControlHeightComfortable}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="{StaticResource FccInset8}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NavigationChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource FccRadiusSmall}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome"
                                        Property="Background"
                                        Value="{DynamicResource FccBrushHoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationChrome"
                                        Property="Background"
                                        Value="{DynamicResource FccBrushPressedOverlay}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FccBrushFocus}" />
                                <Setter TargetName="NavigationChrome"
                                        Property="BorderThickness"
                                        Value="{StaticResource FccFocusRingThickness}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FccBrushSelectionForeground}" />
                                <Setter TargetName="NavigationChrome"
                                        Property="Background"
                                        Value="{DynamicResource FccBrushSelectionBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FccBrushTextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding State, ElementName=Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="{StaticResource FccInset12}"
                BorderBrush="{DynamicResource FccBrushDivider}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Workspace"
                           Style="{StaticResource FccTextSection}"
                           Foreground="{DynamicResource FccBrushTextPrimary}" />
                <TextBlock Margin="0,2,0,0"
                           Text="Projects, sessions and tasks"
                           Style="{StaticResource FccTextMetadata}"
                           Foreground="{DynamicResource FccBrushTextMuted}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource FccInset8}">
            <Button x:Name="ProjectsNavigationButton"
                    Tag="{Binding IsProjectsSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static shell:WorkspaceSection.Projects}"
                    Style="{StaticResource FccWorkspaceNavigationButton}"
                    AutomationProperties.Name="Projects navigation">
                <TextBlock Text="Projects"
                           Style="{StaticResource FccTextBody}" />
            </Button>

            <Button x:Name="SessionsNavigationButton"
                    Tag="{Binding IsSessionsSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static shell:WorkspaceSection.Sessions}"
                    Style="{StaticResource FccWorkspaceNavigationButton}"
                    AutomationProperties.Name="Sessions navigation">
                <TextBlock Text="Sessions"
                           Style="{StaticResource FccTextBody}" />
            </Button>

            <Button x:Name="TasksNavigationButton"
                    Tag="{Binding IsTasksSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static shell:WorkspaceSection.Tasks}"
                    Style="{StaticResource FccWorkspaceNavigationButton}"
                    AutomationProperties.Name="Tasks navigation">
                <TextBlock Text="Tasks"
                           Style="{StaticResource FccTextBody}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
