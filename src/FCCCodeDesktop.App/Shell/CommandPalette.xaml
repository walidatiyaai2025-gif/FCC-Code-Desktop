<UserControl x:Class="FCCCodeDesktop.App.Shell.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Visibility="Collapsed"
             Focusable="False"
             PreviewKeyDown="OnPreviewKeyDown"
             AutomationProperties.Name="Command palette">
    <UserControl.Resources>
        <Style x:Key="FccCommandPaletteTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="{StaticResource FccControlHeightComfortable}" />
            <Setter Property="Padding" Value="{StaticResource FccInset8}" />
            <Setter Property="Background" Value="{DynamicResource FccBrushSurfaceSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushBorder}" />
            <Setter Property="BorderThickness" Value="{StaticResource FccFocusRingThickness}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FccBrushTextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="SearchChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource FccRadiusMedium}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FccBrushFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FccBrushTextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FccCommandPaletteItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="{StaticResource FccInset8}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource FccRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="Background"
                                        Value="{DynamicResource FccBrushHoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FccBrushSelectionForeground}" />
                                <Setter TargetName="ItemChrome"
                                        Property="Background"
                                        Value="{DynamicResource FccBrushSelectionBackground}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FccBrushFocus}" />
                                <Setter TargetName="ItemChrome"
                                        Property="BorderThickness"
                                        Value="{StaticResource FccFocusRingThickness}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource FccBrushCanvas}"
                Opacity="0.78" />

        <Border x:Name="PaletteChrome"
                MaxWidth="680"
                MaxHeight="520"
                Margin="{StaticResource FccInset24}"
                Padding="{StaticResource FccInset16}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{DynamicResource FccBrushSurfaceRaised}"
                BorderBrush="{DynamicResource FccBrushBorder}"
                BorderThickness="{StaticResource FccFocusRingThickness}"
                CornerRadius="{StaticResource FccRadiusLarge}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Command Palette"
                               Style="{StaticResource FccTextSection}"
                               Foreground="{DynamicResource FccBrushTextPrimary}" />
                    <TextBlock Grid.Column="1"
                               Text="Ctrl+Shift+P · F1"
                               Style="{StaticResource FccTextStatus}"
                               Foreground="{DynamicResource FccBrushTextMuted}" />
                </Grid>

                <TextBox x:Name="SearchBox"
                         Grid.Row="1"
                         Margin="0,12,0,8"
                         Text="{Binding State.FilterText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FccCommandPaletteTextBox}"
                         AutomationProperties.Name="Command palette search"
                         AutomationProperties.HelpText="Type to filter registered shell commands" />

                <Grid Grid.Row="2">
                    <ListBox x:Name="CommandList"
                             MaxHeight="360"
                             ItemsSource="{Binding State.FilteredCommands, ElementName=Root}"
                             SelectedIndex="{Binding State.SelectedIndex, ElementName=Root, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FccCommandPaletteItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnCommandDoubleClick"
                             AutomationProperties.Name="Command results">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource FccTextBody}" />
                                        <TextBlock Text="{Binding Category}"
                                                   Style="{StaticResource FccTextMetadata}"
                                                   Foreground="{DynamicResource FccBrushTextMuted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding GestureText}"
                                               Style="{StaticResource FccTextStatus}"
                                               Foreground="{DynamicResource FccBrushTextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="No matching commands"
                               Foreground="{DynamicResource FccBrushTextMuted}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FccTextBody}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.HasMatches, ElementName=Root}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        Padding="0,8,0,0"
                        BorderBrush="{DynamicResource FccBrushDivider}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="Up/Down navigate · Enter run · Esc close"
                               Style="{StaticResource FccTextStatus}"
                               Foreground="{DynamicResource FccBrushTextMuted}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
