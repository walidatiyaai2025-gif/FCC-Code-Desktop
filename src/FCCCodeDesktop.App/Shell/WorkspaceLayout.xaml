<UserControl x:Class="FCCCodeDesktop.App.Shell.WorkspaceLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             Background="{DynamicResource FccBrushCanvas}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             AutomationProperties.Name="Main workspace layout">
    <UserControl.Resources>
        <GridLength x:Key="FccWorkspaceSplitterWidth">4</GridLength>
    </UserControl.Resources>

    <Grid x:Name="WorkspaceGrid" Background="{DynamicResource FccBrushCanvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn"
                              Width="{Binding State.LeftPaneWidth, ElementName=Root, Mode=TwoWay}" />
            <ColumnDefinition Width="{StaticResource FccWorkspaceSplitterWidth}" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="{StaticResource FccWorkspaceSplitterWidth}" />
            <ColumnDefinition x:Name="RightPaneColumn"
                              Width="{Binding State.RightPaneWidth, ElementName=Root, Mode=TwoWay}" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource FccBrushSurface}"
                BorderBrush="{DynamicResource FccBrushDivider}"
                BorderThickness="0,0,1,0">
            <ContentControl x:Name="LeftRegionHost"
                            Content="{Binding LeftContent, ElementName=Root}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Focusable="False"
                            AutomationProperties.Name="Navigation region" />
        </Border>

        <GridSplitter x:Name="LeftSplitter"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource FccBrushDivider}"
                      Focusable="True"
                      AutomationProperties.Name="Resize navigation region" />

        <Border Grid.Column="2"
                Background="{DynamicResource FccBrushCanvas}">
            <ContentControl x:Name="PrimaryRegionHost"
                            Content="{Binding PrimaryContent, ElementName=Root}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Focusable="False"
                            AutomationProperties.Name="Primary workspace region" />
        </Border>

        <GridSplitter x:Name="RightSplitter"
                      Grid.Column="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource FccBrushDivider}"
                      Focusable="True"
                      AutomationProperties.Name="Resize context region" />

        <Border Grid.Column="4"
                Background="{DynamicResource FccBrushSurface}"
                BorderBrush="{DynamicResource FccBrushDivider}"
                BorderThickness="1,0,0,0">
            <ContentControl x:Name="RightRegionHost"
                            Content="{Binding RightContent, ElementName=Root}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Focusable="False"
                            AutomationProperties.Name="Context region" />
        </Border>
    </Grid>
</UserControl>
