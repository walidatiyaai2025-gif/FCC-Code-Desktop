<UserControl x:Class="FCCCodeDesktop.App.Shell.ToolApprovalSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Coding tool approval">
    <Border Background="{DynamicResource FccBrushSurface}" BorderBrush="{DynamicResource FccBrushAccent}"
            BorderThickness="2" CornerRadius="{StaticResource FccRadiusLarge}"
            Padding="{StaticResource FccInset20}" MaxWidth="720" MaxHeight="500" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Approve coding operation" Style="{StaticResource FccTextSection}"
                       Foreground="{DynamicResource FccBrushTextPrimary}" />
            <TextBlock x:Name="RequestTitle" Grid.Row="1" Margin="0,10,0,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource FccBrushTextSecondary}" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="RequestInput" FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource FccBrushTextPrimary}" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Deny" Padding="16,8" Click="OnDenyClick" AutomationProperties.Name="Deny this operation" />
                <Button Content="Allow once" Margin="12,0,0,0" Padding="16,8" Click="OnAllowClick"
                        AutomationProperties.Name="Allow this operation once" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
