<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Component-level geometry for the application chrome. -->
    <sys:Double x:Key="FccAppChromeHeight">40</sys:Double>
    <sys:Double x:Key="FccAppChromeCaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="FccAppChromeGlyphSize">10</sys:Double>
    <sys:Double x:Key="FccAppChromeGlyphStroke">1.2</sys:Double>
    <Thickness x:Key="FccAppChromeZeroThickness">0</Thickness>
    <Thickness x:Key="FccAppChromeResizeBorderThickness">6</Thickness>
    <Thickness x:Key="FccAppChromeFrameBorderThickness">1</Thickness>
    <Thickness x:Key="FccAppChromeTitlePadding">12,0,8,0</Thickness>
    <Thickness x:Key="FccAppChromeContextPadding">8,0,8,0</Thickness>
    <Thickness x:Key="FccAppChromeStatusPadding">8,0,4,0</Thickness>
    <Thickness x:Key="FccAppChromeBottomDividerThickness">0,0,0,1</Thickness>

    <!-- Original vector geometry, intentionally independent of third-party icon packs. -->
    <Geometry x:Key="FccChromeMinimizeGlyph">M 1,7 L 9,7</Geometry>
    <Geometry x:Key="FccChromeMaximizeGlyph">M 1,1 L 9,1 L 9,9 L 1,9 Z</Geometry>
    <Geometry x:Key="FccChromeRestoreGlyph">M 3,1 L 9,1 L 9,7 M 1,3 L 7,3 L 7,9 L 1,9 Z</Geometry>
    <Geometry x:Key="FccChromeCloseGlyph">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>

    <Style x:Key="FccChromeCaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{StaticResource FccAppChromeCaptionButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource FccAppChromeHeight}" />
        <Setter Property="Padding" Value="{StaticResource FccAppChromeZeroThickness}" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource FccBrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="{StaticResource FccAppChromeZeroThickness}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FccBrushHoverOverlay}" />
                <Setter Property="Foreground" Value="{DynamicResource FccBrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource FccBrushPressedOverlay}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FccBrushFocus}" />
                <Setter Property="BorderThickness" Value="{DynamicResource FccFocusRingThickness}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FccChromeCloseButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FccChromeCaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FccBrushErrorBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource FccBrushError}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource FccBrushError}" />
                <Setter Property="Foreground" Value="{DynamicResource FccBrushTextInverse}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
