<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Windows-native typography baseline. The interface face is available
        across supported Windows 10/11 targets; the monospace face is likewise
        system-provided, avoiding a font-package/runtime dependency.
    -->
    <FontFamily x:Key="FccFontFamilyInterface">Segoe UI</FontFamily>
    <FontFamily x:Key="FccFontFamilyCode">Consolas</FontFamily>

    <!-- Workbench hierarchy: intentionally compact, never marketing-sized. -->
    <sys:Double x:Key="FccFontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FccFontSizeSection">15</sys:Double>
    <sys:Double x:Key="FccFontSizeBody">13</sys:Double>
    <sys:Double x:Key="FccFontSizeMetadata">12</sys:Double>
    <sys:Double x:Key="FccFontSizeStatus">11</sys:Double>
    <sys:Double x:Key="FccFontSizeCode">13</sys:Double>

    <sys:Double x:Key="FccLineHeightDisplay">30</sys:Double>
    <sys:Double x:Key="FccLineHeightSection">22</sys:Double>
    <sys:Double x:Key="FccLineHeightBody">19</sys:Double>
    <sys:Double x:Key="FccLineHeightMetadata">18</sys:Double>
    <sys:Double x:Key="FccLineHeightStatus">16</sys:Double>
    <sys:Double x:Key="FccLineHeightCode">19</sys:Double>

    <Style x:Key="FccTextBase" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FccFontFamilyInterface}" />
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="FccTextDisplay"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}">
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeDisplay}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FccTextSection"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}">
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeSection}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FccTextBody"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}" />

    <Style x:Key="FccTextMetadata"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}">
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeMetadata}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightMetadata}" />
    </Style>

    <Style x:Key="FccTextStatus"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}">
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeStatus}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightStatus}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FccTextCode"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource FccTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FccFontFamilyCode}" />
        <Setter Property="FontSize" Value="{StaticResource FccFontSizeCode}" />
        <Setter Property="LineHeight" Value="{StaticResource FccLineHeightCode}" />
    </Style>
</ResourceDictionary>
