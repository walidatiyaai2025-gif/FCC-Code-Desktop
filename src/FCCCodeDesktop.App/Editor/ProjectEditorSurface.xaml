<UserControl x:Class="FCCCodeDesktop.App.Editor.ProjectEditorSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:FCCCodeDesktop.App.Editor"
             x:Name="Root"
             Background="{DynamicResource FccBrushCanvas}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="Project editor workspace">
    <UserControl.Resources>
        <Style x:Key="EditorActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="{StaticResource FccControlHeightStandard}" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource FccBrushSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Border Padding="{StaticResource FccInset12}"
            Background="{DynamicResource FccBrushSurface}"
            BorderBrush="{DynamicResource FccBrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource FccRadiusMedium}">
        <Grid DataContext="{Binding Workspace, ElementName=Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Editor"
                               Style="{StaticResource FccTextSection}"
                               Foreground="{DynamicResource FccBrushTextPrimary}" />
                    <TextBlock Margin="0,3,12,0"
                               Text="Tabs preserve encoding and newline policy; stale external writes fail closed."
                               TextWrapping="Wrap"
                               Style="{StaticResource FccTextMetadata}"
                               Foreground="{DynamicResource FccBrushTextMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Save"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource EditorActionButton}"
                            Click="OnSaveClick"
                            AutomationProperties.Name="Save active editor tab" />
                    <Button Content="Reload"
                            IsEnabled="{Binding CanReload}"
                            Style="{StaticResource EditorActionButton}"
                            Click="OnReloadClick"
                            AutomationProperties.Name="Reload active editor tab" />
                    <Button Content="Close"
                            IsEnabled="{Binding CanClose}"
                            Style="{StaticResource EditorActionButton}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="Close active editor tab" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Padding="8,5"
                    Background="{DynamicResource FccBrushErrorBackground}"
                    BorderBrush="{DynamicResource FccBrushError}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource FccRadiusSmall}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Style="{StaticResource FccTextMetadata}"
                           Foreground="{DynamicResource FccBrushError}" />
            </Border>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TabControl ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource FccBrushBorder}"
                            AutomationProperties.Name="Open editor tabs">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}"
                                       ToolTip="{Binding RelativePath}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="180"
                                       Style="{StaticResource FccTextMetadata}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <editor:CodeEditorControl Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DocumentLabel="{Binding RelativePath}"
                                                      LanguageLabel="{Binding LanguageLabel}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDocuments}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock HorizontalAlignment="Center"
                               Text="No file open"
                               Style="{StaticResource FccTextSection}"
                               Foreground="{DynamicResource FccBrushTextPrimary}" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               MaxWidth="340"
                               Text="Select a text file in the project tree. Binary and oversized files are refused before editor materialization."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Style="{StaticResource FccTextMetadata}"
                               Foreground="{DynamicResource FccBrushTextMuted}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Margin="0,8,0,0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Style="{StaticResource FccTextMetadata}"
                       Foreground="{DynamicResource FccBrushTextSecondary}"
                       AutomationProperties.Name="Editor lifecycle status" />
        </Grid>
    </Border>
</UserControl>
