<UserControl x:Class="FCCCodeDesktop.App.Conversation.TaskExecutionSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource FccBrushCanvas}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             AutomationProperties.Name="Task execution status">
    <Grid DataContext="{Binding State, ElementName=Root}"
          Background="{DynamicResource FccBrushCanvas}">
        <Border Margin="{StaticResource FccInset16}"
                Padding="{StaticResource FccInset20}"
                VerticalAlignment="Top"
                Background="{DynamicResource FccBrushSurface}"
                BorderBrush="{DynamicResource FccBrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource FccRadiusLarge}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Task execution"
                               Style="{StaticResource FccTextSection}"
                               Foreground="{DynamicResource FccBrushTextPrimary}" />
                    <Border Margin="12,0,0,0"
                            Padding="8,3"
                            Background="{DynamicResource FccBrushSurfaceRaised}"
                            BorderBrush="{DynamicResource FccBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource FccRadiusSmall}">
                        <TextBlock x:Name="TaskStateLabel"
                                   Text="{Binding StateLabel}"
                                   Style="{StaticResource FccTextStatus}"
                                   Foreground="{DynamicResource FccBrushAccent}" />
                    </Border>
                </DockPanel>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding RuntimeAvailabilityText}"
                           Style="{StaticResource FccTextStatus}"
                           Foreground="{DynamicResource FccBrushTextMuted}" />

                <TextBlock Margin="0,16,0,0"
                           Text="{Binding Summary}"
                           TextWrapping="Wrap"
                           Style="{StaticResource FccTextBody}"
                           Foreground="{DynamicResource FccBrushTextPrimary}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Task" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ActiveTaskId}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextSecondary}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="Run" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" Text="{Binding ActiveRunId}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextSecondary}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="Attempt" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,6,0,0" Text="{Binding Attempt}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextSecondary}" />
                </Grid>

                <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                    <Button x:Name="StopTaskButton"
                            MinWidth="96"
                            Padding="12,7"
                            Content="Stop"
                            IsEnabled="{Binding CanStop}"
                            Click="OnStopClick"
                            ToolTip="Request cancellation of the active runtime execution"
                            AutomationProperties.Name="Stop active task" />
                    <Button x:Name="RetryTaskButton"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Padding="12,7"
                            Content="Retry"
                            IsEnabled="{Binding CanRetry}"
                            Click="OnRetryClick"
                            ToolTip="Retry the same logical task with a new run"
                            AutomationProperties.Name="Retry failed or cancelled task" />
                </StackPanel>

                <Border Margin="0,16,0,0"
                        Padding="{StaticResource FccInset12}"
                        Background="{DynamicResource FccBrushSurfaceRaised}"
                        BorderBrush="{DynamicResource FccBrushError}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource FccRadiusMedium}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding FailureMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource FccTextBody}"
                               Foreground="{DynamicResource FccBrushError}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
