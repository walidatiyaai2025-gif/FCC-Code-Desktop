<UserControl x:Class="FCCCodeDesktop.App.Conversation.ConversationSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="clr-namespace:FCCCodeDesktop.App.Conversation"
             x:Name="Root"
             Background="{DynamicResource FccBrushCanvas}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="Agent conversation">
    <Grid DataContext="{Binding State, ElementName=Root}" Background="{DynamicResource FccBrushCanvas}">
        <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="180" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <ListBox x:Name="ConversationItems"
                 Grid.Row="0"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="{StaticResource FccInset16}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1,1"
                 VirtualizingPanel.CacheLengthUnit="Page"
                 AutomationProperties.Name="Conversation messages">
            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type conversation:ConversationMessageState}">
                    <Border x:Name="MessageBubble" MaxWidth="760" Padding="{StaticResource FccInset12}" HorizontalAlignment="Left" Background="{DynamicResource FccBrushSurfaceRaised}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusMedium}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding SenderLabel}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextSecondary}" />
                                <TextBlock x:Name="MessageStatus" Margin="8,0,0,0" Text="Complete" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" />
                            </DockPanel>
                            <TextBlock x:Name="MessageText" Margin="0,8,0,0" Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource FccTextBody}" Foreground="{DynamicResource FccBrushTextPrimary}" Visibility="Collapsed" />
                            <ItemsControl x:Name="RenderedContent" Margin="0,8,0,0" ItemsSource="{Binding ContentBlocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type conversation:ConversationContentBlock}">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock x:Name="BodyText" Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource FccTextBody}" Foreground="{DynamicResource FccBrushTextPrimary}" />
                                            <Border x:Name="CodeBlock" Padding="10,7" Visibility="Collapsed" Background="{DynamicResource FccBrushSurface}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusSmall}">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><TextBlock x:Name="CodeText" Text="{Binding Text}" TextWrapping="NoWrap" Style="{StaticResource FccTextCode}" Foreground="{DynamicResource FccBrushTextPrimary}" /></ScrollViewer>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.Heading}"><Setter TargetName="BodyText" Property="Style" Value="{StaticResource FccTextSection}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.Code}"><Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" /><Setter TargetName="CodeBlock" Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.DiffHeader}"><Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" /><Setter TargetName="CodeBlock" Property="Visibility" Value="Visible" /><Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource FccBrushAccent}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.DiffAdded}"><Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" /><Setter TargetName="CodeBlock" Property="Visibility" Value="Visible" /><Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource FccBrushAccent}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.DiffRemoved}"><Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" /><Setter TargetName="CodeBlock" Property="Visibility" Value="Visible" /><Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource FccBrushError}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static conversation:ConversationContentBlockKind.DiffContext}"><Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" /><Setter TargetName="CodeBlock" Property="Visibility" Value="Visible" /><Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource FccBrushTextSecondary}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="{x:Static conversation:ConversationMessageRole.User}"><Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource FccBrushSelectionBackground}" /><Setter TargetName="MessageStatus" Property="Text" Value="Sent" /><Setter TargetName="MessageStatus" Property="Foreground" Value="{DynamicResource FccBrushSelectionForeground}" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsStreaming}" Value="True"><Setter TargetName="MessageStatus" Property="Text" Value="Streaming" /><Setter TargetName="MessageStatus" Property="Foreground" Value="{DynamicResource FccBrushAccent}" /><Setter TargetName="MessageText" Property="Visibility" Value="Visible" /><Setter TargetName="RenderedContent" Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsTextTruncated}" Value="True"><Setter TargetName="MessageStatus" Property="Text" Value="Preview limited" /></DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="HistoryWindowNotice" Grid.Row="0" Panel.ZIndex="2" Margin="16,8,16,0" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource FccBrushSurface}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusSmall}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasHiddenMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding HistoryWindowText}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" />
        </Border>

        <Border x:Name="ConversationEmptyState" Grid.Row="0" Margin="{StaticResource FccInset16}" Padding="{StaticResource FccInset24}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource FccBrushSurface}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusLarge}" AutomationProperties.Name="Empty conversation">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel MaxWidth="420"><TextBlock Text="Conversation ready" Style="{StaticResource FccTextSection}" TextAlignment="Center" Foreground="{DynamicResource FccBrushTextPrimary}" /><TextBlock Margin="0,8,0,0" Text="Assistant output will appear here incrementally when a task starts." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource FccTextBody}" Foreground="{DynamicResource FccBrushTextMuted}" /></StackPanel>
        </Border>

        <Border x:Name="ToolTimelinePanel" Grid.Row="1" MaxHeight="240" Margin="16,0,16,16" Background="{DynamicResource FccBrushSurface}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusMedium}" AutomationProperties.Name="Tool activity timeline">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasToolActivities}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="12,10,12,8"><TextBlock Text="Tool activity" Style="{StaticResource FccTextSection}" Foreground="{DynamicResource FccBrushTextPrimary}" /><TextBlock Margin="10,0,0,0" Text="Structured runtime events" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" /></DockPanel>
                <ListBox x:Name="ToolTimelineItems" Grid.Row="1" ItemsSource="{Binding ToolActivities}" Background="Transparent" BorderThickness="0" Padding="12,0,12,8" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" AutomationProperties.Name="Tool activity items">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type conversation:ToolActivityState}"><Border Padding="10" Background="{DynamicResource FccBrushSurfaceRaised}" BorderBrush="{DynamicResource FccBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource FccRadiusSmall}"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding ToolName}" Style="{StaticResource FccTextBody}" FontWeight="SemiBold" Foreground="{DynamicResource FccBrushTextPrimary}" /><TextBlock x:Name="ToolStatus" Margin="10,0,0,0" Text="{Binding StatusLabel}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushAccent}" /><TextBlock Margin="10,0,0,0" Text="{Binding LastUpdatedUtc, StringFormat={}{0:HH:mm:ss} UTC}" Style="{StaticResource FccTextStatus}" Foreground="{DynamicResource FccBrushTextMuted}" /></DockPanel><TextBlock Margin="0,6,0,0" Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="{DynamicResource FccBrushTextSecondary}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FccTextStatus}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProgress}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Margin="0,6,0,0" Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{DynamicResource FccBrushTextSecondary}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FccTextStatus}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static conversation:ToolActivityStatus.ResultReceived}"><Setter TargetName="ToolStatus" Property="Foreground" Value="{DynamicResource FccBrushTextSecondary}" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <conversation:ConversationComposer x:Name="ConversationComposerHost" Grid.Row="2" State="{Binding Composer, ElementName=Root}" />
    </Grid>
</UserControl>
