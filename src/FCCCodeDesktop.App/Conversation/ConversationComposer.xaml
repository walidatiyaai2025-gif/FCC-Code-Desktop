<UserControl x:Class="FCCCodeDesktop.App.Conversation.ConversationComposer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="clr-namespace:FCCCodeDesktop.App.Conversation"
             x:Name="Root"
             Background="Transparent"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="Conversation composer">
    <UserControl.Resources>
        <Style x:Key="ComposerSecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="{StaticResource FccControlHeightStandard}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource FccBrushSurfaceSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource FccRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FccBrushHoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FccBrushPressedOverlay}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FccBrushFocus}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="{StaticResource FccFocusRingThickness}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource FccBrushTextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerPrimaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ComposerSecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource FccBrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushAccentForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushAccent}" />
        </Style>
    </UserControl.Resources>

    <Border Margin="16,0,16,16"
            Padding="{StaticResource FccInset12}"
            Background="{DynamicResource FccBrushSurface}"
            BorderBrush="{DynamicResource FccBrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource FccRadiusMedium}">
        <Grid DataContext="{Binding State, ElementName=Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl x:Name="ContextItems"
                          Grid.Row="0"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding ContextReferences}"
                          AutomationProperties.Name="Composer context references">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContextReferences}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type conversation:ComposerContextReferenceState}">
                        <Border Margin="0,0,6,6"
                                Padding="6,3"
                                Background="{DynamicResource FccBrushSurfaceSubtle}"
                                BorderBrush="{DynamicResource FccBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource FccRadiusSmall}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding KindLabel}"
                                           Style="{StaticResource FccTextStatus}"
                                           Foreground="{DynamicResource FccBrushAccent}" />
                                <TextBlock Margin="6,0,0,0"
                                           MaxWidth="240"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource FccTextStatus}"
                                           Foreground="{DynamicResource FccBrushTextSecondary}" />
                                <Button Margin="6,0,0,0"
                                        Padding="4,0"
                                        Content="×"
                                        Command="{Binding DataContext.RemoveContextReferenceCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ComposerSecondaryButton}"
                                        MinHeight="0"
                                        AutomationProperties.Name="Remove context reference" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="AttachmentItems"
                          Grid.Row="1"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding Attachments}"
                          AutomationProperties.Name="Composer attachments">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type conversation:ComposerAttachmentState}">
                        <Border Margin="0,0,6,6"
                                Padding="6,3"
                                Background="{DynamicResource FccBrushSurfaceRaised}"
                                BorderBrush="{DynamicResource FccBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource FccRadiusSmall}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="240"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource FccTextStatus}"
                                           Foreground="{DynamicResource FccBrushTextPrimary}" />
                                <TextBlock Margin="6,0,0,0"
                                           Text="{Binding SizeLabel}"
                                           Style="{StaticResource FccTextStatus}"
                                           Foreground="{DynamicResource FccBrushTextMuted}" />
                                <Button Margin="6,0,0,0"
                                        Padding="4,0"
                                        Content="×"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ComposerSecondaryButton}"
                                        MinHeight="0"
                                        AutomationProperties.Name="Remove attachment" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2">
                <TextBox x:Name="ComposerTextBox"
                         MinHeight="72"
                         MaxHeight="180"
                         Padding="{StaticResource FccInset8}"
                         AcceptsReturn="True"
                         Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="12000"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource FccBrushSurfaceRaised}"
                         Foreground="{DynamicResource FccBrushTextPrimary}"
                         BorderBrush="{DynamicResource FccBrushBorder}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource FccBrushTextPrimary}"
                         SelectionBrush="{DynamicResource FccBrushSelectionBackground}"
                         KeyDown="ComposerTextBox_KeyDown"
                         AutomationProperties.Name="Composer message" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AttachFilesButton"
                                Margin="0,0,6,0"
                                Content="Attach files"
                                Click="AttachFilesButton_Click"
                                Style="{StaticResource ComposerSecondaryButton}"
                                AutomationProperties.Name="Attach files" />
                        <Button x:Name="AddContextButton"
                                Margin="0,0,6,0"
                                Content="Add context"
                                Click="AddContextButton_Click"
                                Style="{StaticResource ComposerSecondaryButton}"
                                AutomationProperties.Name="Add file context" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ComposerSecondaryButton}"
                                AutomationProperties.Name="Clear composer" />
                        <TextBlock Margin="10,7,0,0"
                                   Text="{Binding DraftCharacterCount, StringFormat={}{0}/12000}"
                                   Style="{StaticResource FccTextStatus}"
                                   Foreground="{DynamicResource FccBrushTextMuted}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource FccBrushError}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FccTextStatus}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button x:Name="SubmitComposerButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Margin="12,0,0,0"
                        Content="Add message"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource ComposerPrimaryButton}"
                        AutomationProperties.Name="Add composer message" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
