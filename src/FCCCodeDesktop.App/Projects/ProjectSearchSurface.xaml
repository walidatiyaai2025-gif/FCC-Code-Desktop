<UserControl x:Class="FCCCodeDesktop.App.Projects.ProjectSearchSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource FccBrushCanvas}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             Focusable="False"
             AutomationProperties.Name="Workspace search">
    <UserControl.Resources>
        <Style x:Key="SearchActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="{StaticResource FccControlHeightStandard}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{DynamicResource FccBrushSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimarySearchActionButton" TargetType="Button" BasedOn="{StaticResource SearchActionButton}">
            <Setter Property="Background" Value="{DynamicResource FccBrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource FccBrushAccentForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FccBrushAccent}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="{StaticResource FccInset12}"
            Background="{DynamicResource FccBrushSurface}"
            BorderBrush="{DynamicResource FccBrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource FccRadiusMedium}"
            DataContext="{Binding State, ElementName=Root}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Workspace search"
                       Style="{StaticResource FccTextSection}"
                       Foreground="{DynamicResource FccBrushTextPrimary}" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchQueryBox"
                         Grid.Column="0"
                         MinHeight="{StaticResource FccControlHeightStandard}"
                         Padding="10,5"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource FccBrushCanvas}"
                         Foreground="{DynamicResource FccBrushTextPrimary}"
                         BorderBrush="{DynamicResource FccBrushBorder}"
                         BorderThickness="1"
                         KeyDown="OnSearchQueryKeyDown"
                         AutomationProperties.Name="Workspace search query" />
                <ComboBox Grid.Column="1"
                          Margin="8,0,0,0"
                          MinWidth="104"
                          MinHeight="{StaticResource FccControlHeightStandard}"
                          ItemsSource="{Binding SearchModes}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Mode, Mode=TwoWay}"
                          Background="{DynamicResource FccBrushSurfaceRaised}"
                          Foreground="{DynamicResource FccBrushTextPrimary}"
                          BorderBrush="{DynamicResource FccBrushBorder}"
                          AutomationProperties.Name="Workspace search mode" />
                <CheckBox Grid.Column="2"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Content="Match case"
                          IsChecked="{Binding MatchCase}"
                          Foreground="{DynamicResource FccBrushTextSecondary}"
                          AutomationProperties.Name="Match search case" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource FccTextMetadata}"
                           Foreground="{DynamicResource FccBrushTextMuted}"
                           AutomationProperties.Name="Workspace search status" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        MinWidth="72"
                        Content="Search"
                        IsEnabled="{Binding CanSearch}"
                        Style="{StaticResource PrimarySearchActionButton}"
                        Click="OnSearchClick"
                        AutomationProperties.Name="Run workspace search" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="72"
                        Content="Cancel"
                        IsEnabled="{Binding CanCancel}"
                        Style="{StaticResource SearchActionButton}"
                        Click="OnCancelSearchClick"
                        AutomationProperties.Name="Cancel workspace search" />
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="8"
                    Background="{DynamicResource FccBrushErrorBackground}"
                    BorderBrush="{DynamicResource FccBrushError}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource FccRadiusSmall}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Style="{StaticResource FccTextMetadata}"
                           Foreground="{DynamicResource FccBrushError}" />
            </Border>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <ListBox ItemsSource="{Binding Matches}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Workspace search results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="8"
                                    Background="{DynamicResource FccBrushCanvas}"
                                    BorderBrush="{DynamicResource FccBrushDivider}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FccRadiusSmall}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LocationLabel}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource FccTextMetadata}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FccBrushTextPrimary}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource FccTextMetadata}"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource FccBrushTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Padding="{StaticResource FccInset20}"
                        Background="{DynamicResource FccBrushCanvas}"
                        BorderBrush="{DynamicResource FccBrushDivider}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource FccRadiusSmall}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMatches}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Text="No search results to show"
                                   Style="{StaticResource FccTextBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FccBrushTextPrimary}" />
                        <TextBlock Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Text="Generated folders and unsafe reparse-point targets are skipped by default."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource FccTextMetadata}"
                                   Foreground="{DynamicResource FccBrushTextMuted}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
