<UserControl x:Class="FCCCodeDesktop.App.Terminal.InteractiveTerminalSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True"
             Background="{DynamicResource FccBrushSurfaceRaised}"
             Foreground="{DynamicResource FccBrushTextPrimary}"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewTextInput="OnPreviewTextInput"
             SizeChanged="OnSurfaceSizeChanged"
             AutomationProperties.Name="Interactive terminal">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Shell" />
            <ComboBox x:Name="ShellSelector"
                      Grid.Column="1"
                      MinHeight="28"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnShellSelectionChanged"
                      AutomationProperties.Name="Terminal shell profile" />
            <Button x:Name="StartButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="10,4"
                    Content="Start"
                    Click="OnStartClicked"
                    AutomationProperties.Name="Start terminal session" />
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Padding="10,4"
                    Content="Close"
                    IsEnabled="False"
                    Click="OnCloseClicked"
                    AutomationProperties.Name="Close terminal session" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="4"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FccBrushTextSecondary}"
                       Text="Ready" />
            <TextBlock Grid.Column="5"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FccBrushTextSecondary}"
                       Text="Ctrl+C copy / interrupt · Ctrl+V paste" />
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource FccBrushDivider}"
                BorderThickness="1"
                Background="#FF0D1117">
            <RichTextBox x:Name="TerminalOutput"
                         Margin="0"
                         Padding="8"
                         IsReadOnly="True"
                         IsDocumentEnabled="False"
                         IsUndoEnabled="False"
                         AcceptsTab="True"
                         FontFamily="Consolas, Cascadia Mono"
                         FontSize="13"
                         Background="Transparent"
                         Foreground="#FFF0F3F6"
                         BorderThickness="0"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         SelectionBrush="#FF2F81F7"
                         PreviewKeyDown="OnPreviewKeyDown"
                         PreviewTextInput="OnPreviewTextInput"
                         AutomationProperties.Name="Terminal output and input surface" />
        </Border>
    </Grid>
</UserControl>
